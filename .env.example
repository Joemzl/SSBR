# SSBR RAG 系统环境变量配置
# 复制此文件为 .env 并填入实际值

# ============ OpenAI API 配置 ============

# API 密钥 (必需)
# 支持原生 OpenAI API 或代理 API (如 UiUiAPI, OpenRouter 等)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# API 代理地址 (可选)
# 如果使用代理 API，取消下行注释并填入代理地址
# 常见代理地址:
#   - UiUiAPI: https://api.uiuiapi.com/v1
#   - OpenRouter: https://openrouter.ai/api/v1
#   - Azure: https://YOUR_RESOURCE.openai.azure.com/
# OPENAI_BASE_URL=https://api.uiuiapi.com/v1

# ============ 使用说明 ============
# 1. 复制此文件: copy .env.example .env
# 2. 编辑 .env 文件，填入您的 API 密钥
# 3. 如果使用代理 API，取消 OPENAI_BASE_URL 注释并填入地址
# 4. 运行脚本验证: python scripts/rag_search.py --query "test" --top-k 1
